{
  "name": "agent-tripwire",
  "version": "0.2.0",
  "description": "Per-project guard: plant decoy secrets and block/alert when Cursor or Claude Code read them",
  "type": "module",
  "license": "MIT",
  "author": "Prashant Singh Chauhan",
  "keywords": [
    "agent",
    "tripwire",
    "decoy",
    "credentials",
    "security",
    "canary",
    "claude-code",
    "codex",
    "cursor",
    "hooks",
    "secrets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/percius47/agent-tripwire.git"
  },
  "bugs": {
    "url": "https://github.com/percius47/agent-tripwire/issues"
  },
  "homepage": "https://github.com/percius47/agent-tripwire#readme",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-tripwire": "./dist/cli.js",
    "agent-tripwire-hook": "./dist/hook-bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');for (const f of ['dist/cli.js','dist/hook-bin.js']){try{fs.chmodSync(f,0o755)}catch(_e){}}\"",
    "test": "vitest run --pool=forks --maxWorkers=2 --test-timeout=20000",
    "test:watch": "vitest --pool=forks --maxWorkers=2 --test-timeout=20000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-notifier": "^8.0.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
